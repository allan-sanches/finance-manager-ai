# Vercel AI Gateway (provedor padrão) — APENAS no servidor, nunca com NEXT_PUBLIC_.
# Criar em vercel.com → AI Gateway → API Keys. Funciona fora da Vercel (ex: Railway).
AI_GATEWAY_API_KEY=

# Modelo no formato "provedor/modelo" do catálogo do gateway. No plano gratuito só parte do
# catálogo é liberada (o DeepSeek V4.1 Flash não é). gpt-5-mini acertou 100% do SCR de teste.
AI_GATEWAY_MODEL=openai/gpt-5-mini

# true = só usa provedores com acordo de retenção zero (os dados financeiros não ficam guardados).
# Exige plano Pro ou Enterprise. Se nenhum provedor do modelo tiver o acordo, a requisição falha.
# O gpt-5-mini já é servido só por provedores com retenção zero, então não precisa no Hobby.
AI_GATEWAY_ZERO_DATA_RETENTION=false

# Google Gemini API key — usada APENAS no servidor (Route Handler).
# NUNCA prefixar com NEXT_PUBLIC_, isso exporia a chave no client bundle.
GEMINI_API_KEY=

# Modelo padrão do Gemini para o pipeline de extração de transações.
GEMINI_MODEL=gemini-2.5-flash

# DeepSeek API key — mesma regra: APENAS no servidor, nunca com NEXT_PUBLIC_.
DEEPSEEK_API_KEY=

# Modelo do DeepSeek (deepseek-flash ou deepseek-v4-pro).
DEEPSEEK_MODEL=deepseek-flash

# Provedor usado enquanto nada for escolhido na tela /configuracoes (gateway | gemini | deepseek).
AI_PROVIDER=gateway

# Postgres. Na Railway: DATABASE_URL=${{Postgres.DATABASE_URL}} (rede privada).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/finance

# Login por e-mail e senha; cada conta tem os próprios dados. Novas contas são criadas pelo admin em /perfil.
# APP_PASSWORD: senha inicial da conta original (admin) até ela trocar a senha no perfil. Enquanto
#   essa conta não tiver e-mail cadastrado, ela entra deixando o e-mail em branco.
# SESSION_SECRET: no mínimo 32 caracteres aleatórios; trocar invalida todas as sessões.
#   Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_PASSWORD=
SESSION_SECRET=
